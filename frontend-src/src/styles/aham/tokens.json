      "$description": "单据表单最大宽度，两列"
    },
    "label": {
      "$value": "88px",
      "$description": "属性栏里的标签宽度"
    },
    "table-min": {
      "$value": "680px",
      "$description": "表格的最小宽度，窄于此宽度时横向滚动"
    },
    "search-width": {
      "$value": "240px",
      "$description": "页眉搜索框的宽度"
    },
    "pop-min": {
      "$value": "200px",
      "$description": "弹层的最小宽度"
    },
    "pop-max": {
      "$value": "360px",
      "$description": "弹层的最大宽度"
    },
    "pop-form": {
      "$value": "320px",
      "$description": "放表单的弹层宽度"
    },
    "menu-width": {
      "$value": "256px",
      "$description": "账户菜单和右键菜单的宽度"
    },
    "toast-width": {
      "$value": "360px",
      "$description": "轻提示的宽度"
    },
    "dialog-width": {
      "$value": "400px",
