{
  "$meta": {
    "name": "Aham UI",
    "version": "9.1.0",
    "$description": "全部取值的唯一来源。每个取值的键名就是 CSS 变量名：键 row 生成 --wb-row。scripts/build.mjs 读本文件生成 aham.css。规则见 rules/2-视觉.md。"
  },
  "color": {
    "$description": "颜色分四组：中性色（底色、线、文字）、主色、状态色、分类色。用途范围见 rules/2-视觉.md 第 1 节。亮色和暗色键名相同，暗色单独取值，不由亮色推算。",
    "$type": "color",
    "light": {
      "bg": {
        "$value": "#FFFFFF",
        "$description": "内容区底色"
      },
      "canvas": {
        "$value": "#EDECEB",
        "$description": "外框、侧栏、打印预览的底色。9.0 按 Claude 客户端侧栏取色（#EDECEB，几乎不带色相），比内容区深一档"
      },
      "fill": {
        "$value": "#F3F3F3",
        "$description": "一行高的小元素底色：分段按钮、评论、标签底、禁用输入框。高度超过一行的区域不用"
      },
      "hover": {
        "$value": "{color.light.fill}",
        "$description": "悬停：和 fill 同值，保留这个名字是为了写清用途"
      },
      "selected": {
        "$value": "#EBEBEA",
        "$description": "选中项、勾选行"
      },
      "button": {
        "$value": "#F3F3F2",
        "$description": "次要按钮的底色：无描边，靠底色识别"
      },
      "button-hover": {
        "$value": "#EBEBEA",
        "$description": "次要按钮悬停"
      },
      "button-press": {
        "$value": "#E3E2E1",
        "$description": "次要按钮按下"
      },
      "nav-hover": {
        "$value": "#E3E2E0",
        "$description": "侧栏导航项的悬停，比当前项浅一档"
      },
      "nav-selected": {
        "$value": "#D5D4D3",
        "$description": "侧栏的当前项和按下。按 Claude 客户端侧栏当前项取色"
      },
      "line": {
        "$value": "#E5E5E4",
        "$description": "分隔线"
      },
      "edge": {
        "$value": "#D6D5D3",
        "$description": "工作面和外框的交界线。比分栏线深一档，让内容区像一块面板"
      },
      "line-soft": {
        "$value": "#EFEFEE",
        "$description": "行与行之间的线：单行列表、设置行、属性行。比分栏线浅一档"
      },
      "line-strong": {
        "$value": "#8C8B89",
        "$description": "输入框和开关的描边，对底色不低于 WCAG 对控件边界要求的 3:1。按钮不画描边，用 button 底色"
      },
      "pop-bg": {
        "$value": "#FFFFFF",
        "$description": "浮层底色"
      },
      "pop-edge": {
        "$value": "#E5E5E4",
        "$description": "浮层和弹窗外缘的 1px 线，写在 shadow-pop 和 shadow-float 里"
      },
      "ink": {
        "$value": "#151515",
        "$description": "正文"
      },
      "ink-2": {
        "$value": "#525251",
        "$description": "字段标签、次要文字"
      },
      "muted": {
        "$value": "#666664",
        "$description": "次要文字、辅助说明、占位文字、空值、表头"
      },
      "faint": {
        "$value": "#888886",
        "$description": "只用于图标和禁用文字，不用于需要读的文字"
      },
      "blue": {
        "$value": "#336EE8",
        "$description": "主色：主按钮、焦点框、当前项标记、进行中的阶段图标。正文链接不用主色"
      },
      "blue-bg": {
        "$value": "#EDF1FA",
        "$description": "主色浅底：信息消息条"
      },
      "action": {
        "$value": "#336EE8",
        "$description": "主按钮底色，白字不低于 4.5:1"
      },
      "action-hover": {
        "$value": "#2A62D6",
        "$description": "主按钮悬停，比静止深一档"
      },
      "action-press": {
        "$value": "#2357C4",
        "$description": "主按钮按下，再深一档"
      },
      "on": {
        "$value": "#FFFFFF",
        "$description": "主按钮文字"
      },
      "success": {
        "$value": "#1F7A4D",
        "$description": "成功：已生效、已完成、通过"
      },
      "success-bg": {
        "$value": "#EAF4EE",
        "$description": "成功提示条的底色"
      },
      "warning": {
        "$value": "#A15C07",
        "$description": "警示：待处理、将到期、可保存但要注意"
      },
      "warning-bg": {
        "$value": "#FBF2E4",
        "$description": "警示提示框的底色"
      },
      "warning-mark": {
        "$value": "#F5E4C6",
        "$description": "要核对的值的文字底色"
      },
      "danger": {
        "$value": "#B42318",
        "$description": "错误：校验失败、已驳回、逾期、删除"
      },
      "danger-bg": {
        "$value": "#FBEBE9",
        "$description": "错误提示框的底色"
      },
      "danger-press": {
        "$value": "#F6DAD6",
        "$description": "危险按钮按下"
      },
      "info": {
        "$value": "#336EE8",
        "$description": "信息：处理中、审批中"
      },
      "info-bg": {
        "$value": "#EDF1FA",
        "$description": "信息提示条的底色"
      },
      "cat-1": {
        "$value": "#336EE8",
        "$description": "分类色 1 蓝"
      },
      "cat-2": {
        "$value": "#0F7B7B",
        "$description": "分类色 2 青"
      },
      "cat-3": {
        "$value": "#3B7D35",
        "$description": "分类色 3 绿"
      },
      "cat-4": {
        "$value": "#B25E09",
        "$description": "分类色 4 琥珀"
      },
      "cat-5": {
        "$value": "#C4421A",
        "$description": "分类色 5 橙红"
      },
      "cat-6": {
        "$value": "#6E56CF",
        "$description": "分类色 6 紫"
      },
      "scrim": {
        "$value": "rgba(0,0,0,0.4)",
        "$description": "模态弹窗的遮罩。按 Claude 客户端设置弹窗实测，约等于黑色 40%"
      }
    },
    "dark": {
      "bg": {
        "$value": "#151515"
      },
      "canvas": {
        "$value": "#0B0B0B"
      },
      "fill": {
        "$value": "#20201F"
      },
      "hover": {
        "$value": "{color.dark.fill}"
      },
      "selected": {
        "$value": "#2C2C2A"
      },
      "button": {
        "$value": "#252524"
      },
      "button-hover": {
        "$value": "#2E2E2C"
      },
      "button-press": {
        "$value": "#383836"
      },
      "nav-hover": {
        "$value": "#191918"
      },
      "nav-selected": {
        "$value": "#232322",
        "$description": "侧栏的当前项和悬停项"
      },
      "line": {
        "$value": "#2E2E2C"
      },
      "edge": {
        "$value": "#343432"
      },
      "line-soft": {
        "$value": "#262624"
      },
      "line-strong": {
        "$value": "#6E6E6B"
      },
      "pop-bg": {
        "$value": "#1A1A19"
      },
      "pop-edge": {
        "$value": "#3A3A38"
      },
      "ink": {
        "$value": "#F5F5F3"
      },
      "ink-2": {
        "$value": "#C4C4C2"
      },
      "muted": {
        "$value": "#A6A6A3"
      },
      "faint": {
        "$value": "#7B7B79"
      },
      "blue": {
        "$value": "#6C97F0"
      },
      "blue-bg": {
        "$value": "#1F2A40"
      },
      "action": {
        "$value": "#336EE8"
      },
      "action-hover": {
        "$value": "#2A62D6"
      },
      "action-press": {
        "$value": "#2357C4"
      },
      "on": {
        "$value": "#FFFFFF"
      },
      "success": {
        "$value": "#6DBE8F"
      },
      "success-bg": {
        "$value": "#1C2A22"
      },
      "warning": {
        "$value": "#E0A84A"
      },
      "warning-bg": {
        "$value": "#2E2617"
      },
      "warning-mark": {
        "$value": "#4A3B1F"
      },
      "danger": {
        "$value": "#F08A7E"
      },
      "danger-bg": {
        "$value": "#33201D"
      },
      "danger-press": {
        "$value": "#452824"
      },
      "info": {
        "$value": "#7EA4F2"
      },
      "info-bg": {
        "$value": "#1F2A40"
      },
      "cat-1": {
        "$value": "#7EA4F2"
      },
      "cat-2": {
        "$value": "#4FB8B8"
      },
      "cat-3": {
        "$value": "#7DBB75"
      },
      "cat-4": {
        "$value": "#E0A84A"
      },
      "cat-5": {
        "$value": "#F08A6A"
      },
      "cat-6": {
        "$value": "#A797F0"
      },
      "scrim": {
        "$value": "rgba(0,0,0,0.5)"
      }
    },
    "contrast-more": {
      "$description": "系统开启增强对比度时的覆盖值，分亮色和暗色两组，控件边界达到 3:1",
      "light": {
        "line": {
          "$value": "#767674",
          "$description": "分隔线和控件描边"
        },
        "muted": {
          "$value": "#474746",
          "$description": "次要文字和图标"
        }
      },
      "dark": {
        "line": {
          "$value": "#7A766F",
          "$description": "分隔线和控件描边"
        },
        "muted": {
          "$value": "{color.dark.muted}",
          "$description": "次要文字和图标：暗色的次要文字已达到 7:1，沿用原值"
        }
      }
    }
  },
  "font": {
    "$description": "无衬线用 Inter Variable（随包附带，SIL OFL），中文回退苹方、微软雅黑；数字和编号用 Inter 的等宽数字。等宽字体 JetBrains Mono 只用于代码。",
    "$type": "fontFamily",
    "font": {
      "$value": "'Inter Variable', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', 'Noto Sans SC', system-ui, sans-serif",
      "$description": "界面字体：Inter 加系统中文字体"
    },
    "mono": {
      "$value": "'JetBrains Mono', 'SF Mono', ui-monospace, Menlo, Consolas, monospace",
      "$description": "等宽字体：只给代码片段和总览页的取值表，金额和编号用 Inter 的等宽数字"
    },
    "font-features": {
      "$value": "'cv01', 'ss03'",
      "$description": "Inter 的字形特性：数字 1 的替代字形、圆形引号；等宽处关闭"
    }
  },
  "text": {
    "$description": "字号。工作台一屏只用 13px 和 12px 两档，20px 标题一页一次，最小 12px。层级先靠颜色，再靠字重 400、500，600 只给标题。",
    "$type": "dimension",
    "text-xs": {
      "$value": "12px",
      "$description": "辅助信息：分组名、计数、属性栏标签、日期等元数据"
    },
    "text-sm": {
      "$value": "{text.body}",
      "$description": "同 body。旧名，样式里改用 body，下个主版本删除",
      "$deprecated": true
    },
    "body": {
      "$value": "13px",
      "$description": "界面正文、列表、表格、表单、页眉标题、侧栏"
    },
    "leading": {
      "$value": "20px",
      "$description": "13px 和 14px 文字的行高，整数像素，文字不落在半像素上"
    },
    "leading-xs": {
      "$value": "16px",
      "$description": "12px 文字的行高"
    },
    "text-base": {
      "$value": "14px",
      "$description": "弹窗标题；对外填报页正文"
    },
    "title": {
      "$value": "20px",
      "$description": "详情页、单据页、设置页标题和打印件标题，一页一次"
    },
    "total": {
      "$value": "24px",
      "$description": "摘要栏合计金额"
    },
    "touch-input": {
      "$value": "16px",
      "$description": "触屏输入字号，防止手机浏览器自动放大"
    }
  },
  "space": {
    "$description": "间距，4 的倍数。留白是首要分隔，先加间距再考虑加线。",
    "$type": "dimension",
    "s1": {
      "$value": "4px",
      "$description": "4px：图标和文字之间、同组小元素之间"
    },
    "s2": {
      "$value": "8px",
      "$description": "8px：控件内边距、同一行的元素之间"
    },
    "s3": {
      "$value": "12px",
      "$description": "12px：表单行之间、卡片内边距"
    },
    "s4": {
      "$value": "16px",
      "$description": "16px：区块内边距、分组之间"
    },
    "s5": {
      "$value": "24px",
      "$description": "24px：区块之间"
    },
    "s6": {
      "$value": "32px",
      "$description": "32px：页面边距、大区块之间"
    },
    "s7": {
      "$value": "48px",
      "$description": "48px：宽屏页面边距、空状态上下留白"
    },
    "s8": {
      "$value": "64px",
      "$description": "64px：页面级大留白"
    }
  },
  "radius": {
    "$description": "圆角三档加胶囊。胶囊只用于开关、头像、计数和进度条。",
    "$type": "dimension",
    "radius-sm": {
      "$value": "4px",
      "$description": "标签、键帽、勾选框、行内标记"
    },
    "radius": {
      "$value": "8px",
      "$description": "按钮、输入框、下拉、弹层、表格外框"
    },
    "radius-lg": {
      "$value": "12px",
      "$description": "弹窗、命令面板、上传区"
    },
    "radius-pill": {
      "$value": "999px",
      "$description": "胶囊：开关、头像、计数和进度条"
    }
  },
  "shadow": {
    "$description": "静置和悬停无阴影，只有浮层有阴影。浮层阴影的第一段是 1px 外缘线（--wb-pop-edge），暗色另有取值。",
    "$type": "shadow",
    "shadow-pop": {
      "$value": "0 0 0 1px var(--wb-pop-edge), 0 2px 6px rgba(0,0,0,0.06), 0 8px 24px rgba(0,0,0,0.10)",
      "$description": "菜单、下拉、提示"
    },
    "shadow-float": {
      "$value": "0 0 0 1px var(--wb-pop-edge), 0 4px 8px rgba(0,0,0,0.06), 0 12px 28px rgba(0,0,0,0.10)",
      "$description": "弹窗、抽屉"
    }
  },
  "size": {
    "$description": "控件和行高。单行列表 44px；数据表格默认 36px、紧凑 32px；触屏和窄屏所有行 44px（pointer: coarse 或宽度 ≤ 640px）。",
    "$type": "dimension",
    "list-row": {
      "$value": "44px",
      "$description": "单行列表（.wb-list-rows）的数据行高度，参考 Linear 截图实测约 48px"
    },
    "row": {
      "$value": "36px",
      "$description": "数据表格的行、表头、分组行的默认高度"
    },
    "row-compact": {
      "$value": "32px",
      "$description": "紧凑档行高"
    },
    "row-double": {
      "$value": "48px",
      "$description": "带副行的两行行高"
    },
    "control": {
      "$value": "32px",
      "$description": "按钮、输入框、下拉的默认高度"
    },
    "header-control": {
      "$value": "28px",
      "$description": "页眉和工具栏里的小按钮、筛选条件"
    },
    "field": {
      "$value": "28px",
      "$description": "表格单元格里的输入框"
    },
    "hit": {
      "$value": "32px",
      "$description": "鼠标设备的最小点击区"
    },
    "touch": {
      "$value": "44px",
      "$description": "触屏的最小点击区和行高"
    },
    "header-row": {
      "$value": "44px",
      "$description": "页眉横条高度"
    },
    "nav-item": {
      "$value": "28px",
      "$description": "侧栏导航项高度，项与项之间 2px"
    },
    "dot": {
      "$value": "6px",
      "$description": "状态点直径"
    },
    "kbd": {
