# Copy this file to `.env` in the same directory and fill in real values.
# Never commit `.env` — it is in .gitignore.

# Where the app stores models, recordings, exports, sqlite, etc.
# Default: ~/.cache/recording-ai
RECORDING_AI_HOME=/Users/<you>/.cache/recording-ai

# ---------- DeepSeek (云端纪要生成) ----------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ---------- NewCRM 金蝶集成 ----------
# NewVoice 上传录音 → 在 NewCRM 创建 recording/minute 工件 + 自动关联商机。
# 热词同步也走同一套 token。
NEWCRM_BASE_URL=https://your-newcrm-host
NEWCRM_TRANSCRIPT_IMPORT_TOKEN=replace-with-LOCAL_TRANSCRIPT_IMPORT_TOKEN-from-newcrm-env

# ---------- 可选：调优 ----------
# NEWVOICE_UPLOAD_MAX_MB=2048           # 上传文件大小上限（默认 2GB）
# NEWVOICE_TMP_TTL_HOURS=24              # tmp 文件清理 TTL
# NEWVOICE_EXPORT_TTL_DAYS=14            # 导出文件清理 TTL
# NEWVOICE_SWEEP_INTERVAL_MINUTES=60     # 清理周期
# NEWVOICE_HOTWORD_LIMIT=3000            # ASR 热词上限
# NEWVOICE_VOICEPRINT_THRESHOLD=0.66     # 声纹默认匹配阈值
# NEWVOICE_INITIAL_PASSWORD=orchisky888888   # 新建用户的初始密码（强制首次修改）
# NEWCRM_AUTO_SYNC=true                  # 生成纪要后自动同步到 NewCRM
